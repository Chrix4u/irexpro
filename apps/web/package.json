{
  "name": "@irexpro/web",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro \u2014 client/trader web app (Next.js 15, App Router, TypeScript).",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:evidence": "cross-env E2E_CAPTURE_EVIDENCE=1 playwright test e2e/evidence.spec.ts e2e/cockpit-evidence.spec.ts --project=mobile-standard --project=tablet-portrait --project=desktop"
  },
  "dependencies": {
    "@irexpro/api-client": "workspace:*",
    "@irexpro/types": "workspace:*",
    "next": "15.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "20.14.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.28",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "5.5.4"
  }
}
