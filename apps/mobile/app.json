{
  "expo": {
    "name": "iRexPro",
    "slug": "irexpro-mobile",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "irexpro",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irexpro.mobile",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.irexpro.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-system-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "d3f2e011-163e-487b-aa77-dbc03dd594df"
      }
    },
    "owner": "lightworld-technologies-limited"
  }
}
