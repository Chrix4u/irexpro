{
  "expo": {
    "name": "iRexPro",
    "slug": "irexpro-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "irexpro",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.irexpro.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.irexpro.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-system-ui"
    ]
  }
}
