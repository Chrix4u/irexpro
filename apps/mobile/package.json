{
  "name": "@irexpro/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro — native mobile app foundation for iOS and Android (Expo + React Native + TypeScript).",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-account-security.cjs && jest",
    "test:broker-mobile": "jest",
    "test:broker-mobile:watch": "jest --watch",
    "validate:release-config": "node ./scripts/validate-release-config.cjs",
    "release:preflight": "node ./scripts/validate-release-config.cjs --require-project-id"
  },
  "dependencies": {
    "@irexpro/api-client": "workspace:*",
    "@irexpro/types": "workspace:*",
    "expo": "~55.0.31",
    "expo-secure-store": "~55.0.18",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "20.14.10",
    "@types/react": "~19.2.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  }
}
