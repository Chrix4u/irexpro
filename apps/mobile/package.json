{
  "name": "@irexpro/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro — native mobile app foundation for iOS and Android (Expo + React Native + TypeScript).",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-account-security.cjs",
    "validate:release-config": "node ./scripts/validate-release-config.cjs",
    "release:preflight": "node ./scripts/validate-release-config.cjs --require-project-id"
  },
  "dependencies": {
    "@irexpro/api-client": "workspace:*",
    "@irexpro/types": "workspace:*",
    "expo": "~54.0.37",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3"
  }
}
