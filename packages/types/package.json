{
  "name": "@irexpro/types",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro — shared frontend-safe TypeScript types (web, admin, mobile). No backend entities or secrets.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./execution": {
      "types": "./src/execution.ts",
      "default": "./src/execution.ts"
    },
    "./orders": {
      "types": "./src/orders.ts",
      "default": "./src/orders.ts"
    },
    "./portfolio": {
      "types": "./src/portfolio.ts",
      "default": "./src/portfolio.ts"
    },
    "./risk-intelligence": {
      "types": "./src/risk-intelligence.ts",
      "default": "./src/risk-intelligence.ts"
    },
    "./ai-decision-explorer": {
      "types": "./src/ai-decision-explorer.ts",
      "default": "./src/ai-decision-explorer.ts"
    },
    "./strategy-lab": {
      "types": "./src/strategy-lab.ts",
      "default": "./src/strategy-lab.ts"
    },
    "./market-intelligence": {
      "types": "./src/market-intelligence.ts",
      "default": "./src/market-intelligence.ts"
    },
    "./ai-copilot": {
      "types": "./src/ai-copilot.ts",
      "default": "./src/ai-copilot.ts"
    },
    "./eligibility": {
      "types": "./src/eligibility.ts",
      "default": "./src/eligibility.ts"
    },
    "./broker-registry": {
      "types": "./src/broker-registry.ts",
      "default": "./src/broker-registry.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.5.4"
  }
}
