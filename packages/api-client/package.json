{
  "name": "@irexpro/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "iRexPro — shared typed API client for web, admin, and mobile. Reads base URL from each app's env config; never hardcodes localhost; never exposes backend secrets.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser-auth": {
      "types": "./src/browser-auth.ts",
      "default": "./src/browser-auth.ts"
    },
    "./execution": {
      "types": "./src/execution.ts",
      "default": "./src/execution.ts"
    },
    "./portfolio": {
      "types": "./src/portfolio.ts",
      "default": "./src/portfolio.ts"
    },
    "./risk-intelligence": {
      "types": "./src/risk-intelligence.ts",
      "default": "./src/risk-intelligence.ts"
    },
    "./ai-decision-explorer": {
      "types": "./src/ai-decision-explorer.ts",
      "default": "./src/ai-decision-explorer.ts"
    },
    "./strategy-lab": {
      "types": "./src/strategy-lab.ts",
      "default": "./src/strategy-lab.ts"
    },
    "./market-intelligence": {
      "types": "./src/market-intelligence.ts",
      "default": "./src/market-intelligence.ts"
    },
    "./ai-copilot": {
      "types": "./src/ai-copilot.ts",
      "default": "./src/ai-copilot.ts"
    },
    "./eligibility": {
      "types": "./src/eligibility.ts",
      "default": "./src/eligibility.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-contracts.cjs"
  },
  "dependencies": {
    "@irexpro/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
