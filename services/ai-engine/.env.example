# iRexPro AI Engine — Environment Variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
#
# PRODUCTION DEPLOYMENT:
#   See docs/runbooks/production-deployment-vps-webuzo.md for the full
#   production setup procedure. Every PLACEHOLDER / dev_* value below MUST
#   be replaced with a strong generated secret before going live.
#   See docs/runbooks/secrets-never-committed.md for the secrets policy.

# ─── Service Identity ────────────────────────────────────────────────────────
# Production: AI_ENGINE_ENV=production (disables /docs + /redoc in FastAPI)
AI_ENGINE_ENV=development
AI_ENGINE_PORT=8001
AI_ENGINE_SERVICE_NAME=irexpro-ai-engine
AI_ENGINE_VERSION=0.1.0

# ─── NestJS API Integration ───────────────────────────────────────────────────
NESTJS_API_BASE_URL=http://localhost:3000/api/v1
NESTJS_AI_SIGNAL_ENDPOINT=/ai/internal/signals
NESTJS_MARKET_DATA_ENDPOINT=/market-data/internal/ohlcv
# SECURITY: Change this key before any deployment. Must EXACTLY match
# NESTJS_INTERNAL_API_KEY in apps/api/.env. A mismatch causes every AI signal
# to be rejected with 401 by NestJS InternalApiKeyGuard.
NESTJS_INTERNAL_API_KEY=dev_internal_key_change_me

# ─── Redis ────────────────────────────────────────────────────────────────────
# Production: strong REDIS_PASSWORD, REDIS_DB=1 (NestJS API uses REDIS_DB=0 —
#   this separation is REQUIRED to avoid BullMQ/OHLCV key collisions).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=irexpro_redis_dev_password
REDIS_DB=1
AI_REDIS_KEY_PREFIX=ai
AI_OHLCV_CACHE_TTL_SECONDS=300

# ─── AI Engine Behaviour ──────────────────────────────────────────────────────
AI_DEFAULT_MODEL_VERSION=baseline-xgboost-v0.1.0
AI_MIN_CONFIDENCE_SCORE=0.60
# IMPORTANT: AI_SIGNAL_MODE 'live' is FAIL-CLOSED: it requires ALL of
#   (1) AI_SIGNAL_MODE=live,
#   (2) AI_ENGINE_ALLOW_LIVE_MODEL=true, AND
#   (3) a valid out-of-band operator promotion record matching the active
#       model_version + verified artifact SHA-256 byte-exactly.
# Any closed gate rejects live mode with LiveModeNotSupportedError (HTTP 403).
# Production: keep AI_SIGNAL_MODE=paper until explicit governance approval.
AI_SIGNAL_MODE=paper
# LIVE ACTIVATION FEATURE GATE (default false). Leave false unless operations
# explicitly enable the live path. See AI_MODEL_PROMOTION_DIR below.
AI_ENGINE_ALLOW_LIVE_MODEL=false
# Directory containing operator-authored model promotion records (JSON).
# Validated fail-closed: malformed/tampered/duplicate records are INVALID and
# never activate live mode. Training code NEVER writes this directory —
# records are created out-of-band by operators only.
# Default: services/ai-engine/var/model-promotions (gitignored)
AI_MODEL_PROMOTION_DIR=
# Production: AI_ALLOW_MOCK_MARKET_DATA=false (NEVER true in production —
#   mock market data is test-only and blocked unless this flag is set).
AI_ALLOW_MOCK_MARKET_DATA=false

# Optional verified trained XGBoost artifact. Leave blank to retain the
# explicitly-labelled heuristic scaffold. A trained model is loaded only when
# the JSON artifact and metadata sidecar exist and their SHA-256/schema match.
XGBOOST_MODEL_PATH=
XGBOOST_MODEL_METADATA_PATH=

# ─── Scheduler (disabled by default) ─────────────────────────────────────────
# Production: set AI_SCHEDULER_ENABLED=true only when you are ready to run the
#   paper-mode signal scheduler. The scheduler publishes signals to NestJS,
#   which then run through the full Risk → Execution pipeline.
AI_SCHEDULER_ENABLED=false
AI_SIGNAL_INTERVAL_SECONDS=60

# ─── CORS (comma-separated) ───────────────────────────────────────────────────
# Production: set to the NestJS API origin only, e.g. https://api.yourdomain.com
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
